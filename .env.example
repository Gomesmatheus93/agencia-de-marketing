DATABASE_URL=mysql://root:SUA_SENHA@localhost:3306/ai_marketing

JWT_SECRET=gere_um_segredo_aleatorio_aqui

OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TOKEN_TTL_SECONDS=600

# D-ID / Talking Avatar API
DID_API_KEY=
DID_API_BASE_URL=https://api.d-id.com
DID_DEFAULT_VOICE_PROVIDER=microsoft
DID_DEFAULT_VOICE_ID=pt-BR-FranciscaNeural

# Storage publico usado para imagens geradas e posts na Meta.
# Use "aws" para S3, "catbox" para Catbox ou "forge" para o storage proxy.
PUBLIC_STORAGE_PROVIDER=aws
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=
# Opcional: use se a URL publica vier de CloudFront ou dominio proprio.
AWS_PUBLIC_BASE_URL=
CATBOX_API_URL=https://catbox.moe/user/api.php
CATBOX_USERHASH=

# Use estas duas variaveis somente se PUBLIC_STORAGE_PROVIDER=forge.
BUILT_IN_FORGE_API_KEY=sua_chave_do_storage_proxy
BUILT_IN_FORGE_API_URL=https://seu-storage-proxy.example.com

# Meta / Instagram Graph API
# Use token de longa duracao com permissao instagram_content_publish.
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_FACEBOOK_PAGE_ID=
POST_SCHEDULER_TIME_ZONE=America/Fortaleza
INSTAGRAM_SCHEDULER_INTERVAL_MS=60000
VITE_POST_SCHEDULER_TIME_ZONE=America/Fortaleza

# LinkedIn Posts API — cada usuário conecta a própria conta via OAuth (Analytics → LinkedIn)
# LINKEDIN_REDIRECT_URI deve ser IDENTICA a uma Redirect URL cadastrada no app em
# https://www.linkedin.com/developers/apps (ex: https://seu-dominio.com/callback)
LINKEDIN_API_BASE_URL=https://api.linkedin.com/rest
LINKEDIN_API_VERSION=202601
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

NODE_ENV=development
PORT=3000

# Migrations no startup do Docker. Defina RUN_MIGRATIONS=false para desativar.
RUN_MIGRATIONS=true
MIGRATION_ATTEMPTS=10
MIGRATION_RETRY_DELAY_MS=3000

# Seed opcional para criar/atualizar um usuario de login local.
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=troque_essa_senha
SEED_USER_NAME=Administrador
SEED_USER_ROLE=admin

VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
