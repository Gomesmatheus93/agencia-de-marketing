# Postgres (Supabase): Connect → Transaction pooler (porta 6543).
# Não use a conexão direta (db.*.supabase.co, só IPv6: falha em container) nem o
# Session pooler (5432, limite de 15 conexões: a plataforma abre até 20).
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres

# Endereço público da plataforma (usado nos retornos de login do Instagram/Meta)
APP_BASE_URL=https://agencia.seu-dominio.com

# Agentes internos (server/agents) — chave da API da Anthropic
ANTHROPIC_API_KEY=

# Fotos de banco usadas pelos agentes nas artes
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# Conta que sempre recebe o papel admin ao fazer login
ADMIN_EMAIL=

JWT_SECRET=gere_um_segredo_aleatorio_aqui

# Segurança — criptografia de campos sensíveis em repouso e hash de senha.
# Gere cada uma com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ATENÇÃO: se perder ENCRYPTION_KEY, os dados cifrados (tokens OAuth, e-mails, etc) ficam irrecuperáveis.
ENCRYPTION_KEY=
BLIND_INDEX_KEY=
# String aleatória qualquer (recomendado 32+ chars). Trocar invalida todas as senhas existentes.
PASSWORD_PEPPER=

# Envio direto de e-mail (verificação, recuperação de senha e 2FA).
# Crie uma chave em https://resend.com/api-keys e valide o domínio de EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM="Alle Energia <no-reply@seu-dominio.com>"

# Alternativa: deixe RESEND_API_KEY vazia e encaminhe os e-mails pelo n8n.
# O n8n deve validar X-Api-Key contra N8N_SECRET.
# Payload: { to, from, subject, html, text, tag }
N8N_EMAIL_WEBHOOK_URL=

# CSP começa em modo report-only (só loga violações em /api/csp-report).
# Depois de validar que nada quebrou nos logs, defina CSP_ENFORCE=true.
CSP_ENFORCE=false

OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TOKEN_TTL_SECONDS=600

# D-ID / Talking Avatar API
DID_API_KEY=
DID_API_BASE_URL=https://api.d-id.com
DID_DEFAULT_VOICE_PROVIDER=microsoft
DID_DEFAULT_VOICE_ID=pt-BR-FranciscaNeural

# Storage publico usado para imagens geradas e posts na Meta.
# Use "aws" para S3, "catbox" para Catbox ou "forge" para o storage proxy.
PUBLIC_STORAGE_PROVIDER=aws
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=
# Opcional: use se a URL publica vier de CloudFront ou dominio proprio.
AWS_PUBLIC_BASE_URL=
CATBOX_API_URL=https://catbox.moe/user/api.php
CATBOX_USERHASH=

# Use estas duas variaveis somente se PUBLIC_STORAGE_PROVIDER=forge.
BUILT_IN_FORGE_API_KEY=sua_chave_do_storage_proxy
BUILT_IN_FORGE_API_URL=https://seu-storage-proxy.example.com

# Meta / Instagram Graph API
# Use token de longa duracao com permissao instagram_content_publish.
META_GRAPH_API_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_FACEBOOK_PAGE_ID=
POST_SCHEDULER_TIME_ZONE=America/Fortaleza
INSTAGRAM_SCHEDULER_INTERVAL_MS=60000
VITE_POST_SCHEDULER_TIME_ZONE=America/Fortaleza

# LinkedIn Posts API — cada usuário conecta a própria conta via OAuth (Analytics → LinkedIn)
# LINKEDIN_REDIRECT_URI deve ser IDENTICA a uma Redirect URL cadastrada no app em
# https://www.linkedin.com/developers/apps (ex: https://seu-dominio.com/callback)
LINKEDIN_API_BASE_URL=https://api.linkedin.com/rest
LINKEDIN_API_VERSION=202601
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=

# Google Search Console API — gratuita, dá dados reais de SEO (cliques, impressões, posição média)
# Setup: console.cloud.google.com → criar credencial OAuth "Web application" → habilitar
# "Google Search Console API" → GOOGLE_GSC_REDIRECT_URI deve ser IDÊNTICA a uma Authorized
# redirect URI cadastrada nessa credencial (ex: https://seu-dominio.com/api/oauth/gsc/connect/callback)
GOOGLE_GSC_CLIENT_ID=
GOOGLE_GSC_CLIENT_SECRET=
GOOGLE_GSC_REDIRECT_URI=

NODE_ENV=development
PORT=3000

# Migrations no startup do Docker. Defina RUN_MIGRATIONS=false para desativar.
RUN_MIGRATIONS=true
MIGRATION_ATTEMPTS=10
MIGRATION_RETRY_DELAY_MS=3000

# Seed opcional para criar/atualizar um usuario de login local.
SEED_USER_EMAIL=admin@example.com
SEED_USER_PASSWORD=troque_essa_senha
SEED_USER_NAME=Administrador
SEED_USER_ROLE=admin

VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
