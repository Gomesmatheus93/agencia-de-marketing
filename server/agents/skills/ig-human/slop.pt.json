  "structures": [
    {
      "id": "nao-e-so",
      "regex": "(?i)\\bn[ãa]o [ée] (?:s[óo]|apenas) [^.!?\\n]{2,60}[,.] [ée]\\b",
      "name": "\"Não é só X, é Y\"",
      "fix": "Diga a única coisa que você quer dizer. Corte a metade da preparação."
    },
    {
      "id": "nao-apenas",
      "regex": "(?i)\\bn[ãa]o (?:s[óo]|apenas)\\b[^.!?\\n]{2,80}\\bmas tamb[ée]m\\b",
      "name": "\"Não apenas X, mas também Y\"",
      "fix": "Separe em duas frases ou corte a parte mais fraca."
    },
    {
      "id": "nao-sobre",
      "regex": "(?i)\\bn[ãa]o [ée] sobre [^.!?\\n]{2,60}[.!] [ée] sobre\\b",
      "name": "\"Não é sobre X. É sobre Y.\"",
      "fix": "Comece pelo Y. A inversão é o sinal de texto pronto."
    },
    {
      "id": "o-resultado",
      "regex": "(?i)^\\s*(?:o resultado|a melhor parte|o segredo|o detalhe|o pulo do gato)\\?\\s*$",
      "name": "Pergunta retórica de uma linha",
      "fix": "Responda na mesma frase em vez de encenar uma revelação."
    },
    {
      "id": "o-que-aprendi",
      "regex": "(?i)\\b(?:veja|aqui est[áa]|olha) o que (?:eu )?aprendi\\b",
      "name": "\"Veja o que eu aprendi\"",
      "fix": "Diga a lição. Pule o anúncio."
    },
    {
      "id": "triade",
      "regex": "(?i)\\b\\w+, \\w+ e \\w+\\.",
      "name": "Trio de três itens",
      "fix": "Dois itens ou quatro. Três é o ritmo padrão do modelo."
    },
    {
      "id": "rocket",
      "regex": "[\\U0001F680\\U0001F525\\U0001F4A1\\u2728\\U0001F3AF]",
      "name": "Emoji de foguete / fogo / lâmpada / brilho / alvo",
      "fix": "No máximo um emoji, e não um desses cinco."
    },
    {
      "id": "hashtag-wall",
      "regex": "(?:#\\w+[ \\t]*){5,}",
      "name": "Parede de hashtags (5+)",
      "fix": "Até 5 hashtags, específicas, no fim."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:uma )?(?:ia|intelig[êe]ncia artificial|modelo de linguagem)\\b",
      "name": "Auto-referência de IA",
      "fix": "Apague a frase."
    },
    {
      "id": "em-resumo",
      "regex": "(?im)^\\s*(?:em resumo|resumindo|em conclus[ãa]o|concluindo)\\b",
      "name": "Abertura de conclusão de redação",
      "fix": "Post não precisa de parágrafo de conclusão."
    },
    {
      "id": "isca",
      "regex": "(?im)(?:concorda\\?|o que voc[êe] acha\\?|quem mais\\b[^\\n]*\\?|estou errad[oa]\\?)\\s*$",
      "name": "Isca de engajamento automática",
      "fix": "Faça uma pergunta que só a Alle poderia fazer, sobre o assunto do post."
    },
    {
      "id": "pare-rolar",
      "regex": "(?im)^\\s*(?:pare de rolar|n[ãa]o role|espera,? n[ãa]o passa)\\b",
      "name": "Abertura \"pare de rolar\"",
      "fix": "O que faz parar é a própria afirmação. Pedir atenção mostra que ela não foi conquistada."
    },
    {
      "id": "neste-video",
      "regex": "(?i)\\b(?:neste|nesse) (?:v[íi]deo|reel|post)\\b|\\bno (?:v[íi]deo|post|reel) de hoje\\b|\\bhoje (?:eu )?vou (?:te |lhes? )?(?:mostrar|ensinar)\\b|\\bvou (?:te )?(?:mostrar|ensinar) como\\b",
      "name": "Preâmbulo de vídeo (\"neste vídeo vou te mostrar\")",
      "fix": "Apague e comece pelo resultado. Os dois primeiros segundos decidem o reel."
    },
    {
      "id": "emoji-bullets",
      "regex": "(?m)^\\s*[\\U0001F300-\\U0001FAFF✅➡⬅✔✨]\\s*\\S",
      "name": "Lista com emojis como marcadores",
      "fix": "Use hífen ou quebra de linha. Emoji como marcador é o que mais parece template."
    },
    {
      "id": "caixa-alta",
      "regex": "\\b[A-ZÀ-Ý]{3,}\\b(?:\\s+\\b[A-ZÀ-Ý]{3,}\\b){2,}",
      "name": "Três ou mais palavras gritadas seguidas",
      "fix": "Caixa alta é volume, não destaque. No máximo uma palavra."
    },
    {
      "id": "isca-seguir",
      "regex": "(?i)\\b(?:siga para mais|marque (?:algu[ée]m|um amigo|uma amiga) que|curta se|compartilhe se|comente aqui se|deixe seu like)\\b",
      "name": "Isca automática de seguir ou marcar",
      "fix": "Peça a única ação que este post merece."
    },
    {
      "id": "corporatives",
      "regex": "(?i)\\b(?:jornada|mindset|ecossistema|game[- ]changer|em um mundo cada vez mais|transforma[çc][ãa]o digital|solu[çc][õo]es inovadoras)\\b",
      "name": "Vocabulário de IA ou corporativês",
      "fix": "Troque pela palavra que a equipe falaria em voz alta (atenção à concordância)."
    }
  ]
}